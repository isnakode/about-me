---
import Base from "../layouts/base.astro";
import Header from "../components/header.astro";

type Repo = {
	name: string;
	html_url: string;
	description: string;
};

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN;
let repos: Repo[] = [];
try {
	let res = await fetch("https://api.github.com/users/isnakode/repos", {
		headers: {
			"User-Agent": "isnaini.dev",
			Authorization: `Bearer ${GITHUB_TOKEN}`,
		},
	});
	repos = await res.json();
	console.log("msg repo:", repos);
} catch (error) {
	console.error("fetch error:", error);
}
---

<Base>
	<Header />

	<h2 class="pb-4">Hi I'm Isnaini</h2>
	<p>
		I build stuff in Rust. Usually graphics, encoders, parsers, network stuff.
		If I learn something cool, I'll probably write about it.
	</p>
	<p>
		You can find me on{" "}
		<a target="_blank" href="https://github.com/isnakode">
			Github
		</a>
		,{" "}
		<a target="_blank" href="https://x.com/isnakode">
			X
		</a>
		,{" "}
		<a target="_blank" href="https://instagram.com/isnakode">
			Instagram
		</a>
	</p>
	<p>and here are some projects i've built:</p>
	<ul>
		{repos.map((repo) => (
			<li>
				<p>
					<a class="font-semibold capitalize" href={repo.html_url}>
						{repo.name}
					</a>
				</p>
				<p>{repo.description ?? "no description"}</p>
			</li>
		))}
	</ul>
</Base>
